<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Dir.fs" />
        <Compile Include="TokenGenerationTest.fs" />
        <None Include="escape.fslex" />
        <Compile Include="EscapeLexerTest.fs" />
        <None Include="block_comment.fslex" />
        <Compile Include="BlockCommentLexerTest.fs" />
        <None Include="braces.fslex" />
        <Compile Include="BracesLexerTest.fs" />
        <None Include="fslex.fslex" />
        <Compile Include="FslexLexerTest.fs" />
        <None Include="fsyacc.fslex" />
        <Compile Include="FsyaccLexerTest.fs" />
        <None Include="fslex_filter.fslex" />
        <Compile Include="FslexFilterTest.fs" />
        <None Include="fslex.fsyacc" />
        <Compile Include="FslexYaccTest.fs" />
        <None Include="fslex_tag.fsyacc" />
        <Compile Include="FslexTagYaccTest.fs" />
        <None Include="fsyacc.fsyacc" />
        <Compile Include="FsyaccYaccTest.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.xUnit" Version="1.4.0" />
        <PackageReference Include="xunit.v3.assert" Version="4.0.0" />
        <PackageReference Include="xunit.v3.core.mtp-v2" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.LexYacc.ToolBox\FSharp.LexYacc.ToolBox.fsproj" />
        <ProjectReference Include="..\FSharp.LexYacc\FSharp.LexYacc.fsproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Update="FSharp.Core" Version="10.1.400" />
    </ItemGroup>

</Project>
