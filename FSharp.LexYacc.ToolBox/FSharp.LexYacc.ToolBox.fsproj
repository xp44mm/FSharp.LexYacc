<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>FSharp.LexYacc的辅助工具</Title>
        <Version>0.0.4</Version>
        <Description>FSharp.LexYacc的辅助工具</Description>
        <Authors>xp44m</Authors>
        <Company>34696643@qq.com</Company>
        <Copyright>xp44mm</Copyright>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReleaseNotes>update fsharp.idioms</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="RawFsyaccFilePrinter.fs" />
        <Compile Include="DummyToken.fs" />
        <Compile Include="SLR.fs" />
        <Compile Include="Declaration.fs" />
        <Compile Include="OperatorsLine.fs" />
        <Compile Include="ConflictedProduction.fs" />
        <Compile Include="Symbol.fs" />
        <Compile Include="DiscriminatedUnions.fs" />
        <Compile Include="BnfUtils.fs" />
        <Compile Include="FlatFsyaccFileUtils.fs" />
        <Compile Include="BnfAnalysisRecord.fs" />
        <Compile Include="ViablePrefixData.fs" />
        <Compile Include="Configuration.fs" />
        <Compile Include="DeclarationStatementUtils.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.LexYacc\FSharp.LexYacc.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.1.300" />
    </ItemGroup>

</Project>
