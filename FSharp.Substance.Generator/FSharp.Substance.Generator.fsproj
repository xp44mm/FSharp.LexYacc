<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>FSharp.Substance.Generator</RootNamespace>
        <TargetFramework>net10.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
        <Compile Include="Dir.fs" />
        <None Include="fsharp.fslex" />
        <Compile Include="FSharpLexerTest.fs" />
        <None Include="fsharp.fsyacc" />
        <Compile Include="FSharpYaccTest.fs" />
        <None Include="denoise.fslex" />
        <Compile Include="TokenGenerationTest.fs" />
        <Compile Include="SpliterTestTest.fs" />
        <Compile Include="FSharpLexerTailerTest.fs" />
        <Compile Include="FSharpCompilerTest.fs" />
        <Compile Include="LightTest.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.xUnit" Version="1.3.0" />

        <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.LexYacc.ToolBox\FSharp.LexYacc.ToolBox.fsproj" />
        <ProjectReference Include="..\FSharp.LexYacc\FSharp.LexYacc.fsproj" />
        <ProjectReference Include="..\FSharp.Substance\FSharp.Substance.fsproj" />
    </ItemGroup>

</Project>
