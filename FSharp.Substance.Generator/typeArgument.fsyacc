{
module FSharp.Substance.TypeArgumentYacc
open FSharp.LexYacc
}

recdLiteralExpr:
  | "{" fieldBindings opt_semicolon "}"  { }

fieldBindings:
  | fieldBinding {  }
  | fieldBindings ";" fieldBinding {  }
  
fieldBinding:
  | IDENT "=" valueExpr RHSEND {  }
  | IDENT "=" LLPAREN revSequentialExpr opt_semicolon RRPAREN {  }

