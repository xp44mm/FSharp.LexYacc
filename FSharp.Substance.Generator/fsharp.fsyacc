{
module FSharp.Substance.FSharpYacc
open FSharp.LexYacc
}

file:
    | MODULE longid rhsBlock EOF {
        snd s1, snd s2
        }

longid:
    | revLongid  {
        let i,ls = s0 |> List.rev |> List.unzip
        i.[0], ls
        }

revLongid :
    | IDENT { [s0] }
    | revLongid "." IDENT { s2 :: s0 }

sequentialExpr:
    | revSequentialExpr { Expr.ofSequentialExpr s0 }

revSequentialExpr:
    | revSequentialExpr ";" declExpr  { s2::s0 }
    | declExpr { [s0] }

declExpr:
    | OPEN longid {s0, OpenExpr(snd s1)}
    | letBinding { s0 }
    | valueExpr { s0 }
    | DUMMY { s0, DummyExpr }

letBinding :
    | LET bindingPattern "=" valueExpr RHSEND {
        s0, LetBindingExpr(snd s1, [snd s3])
        }
    | LET bindingPattern "=" rhsBlock {
        s0, LetBindingExpr(snd s1, snd s3)
        }

rhsBlock:
    | LLPAREN sequentialExpr RRPAREN { s1 }

valueExpr :
    | lambdaExpr { s0 }
    | tupleExpr { s0 }

lambdaExpr:
    | FUN parameterPattern "->" valueExpr RHSEND {
            s0, LambdaExpr(snd s1, [snd s3])
        }
    | FUN parameterPattern "->" rhsBlock {
            s0, LambdaExpr(snd s1, snd s3)
        }

tupleExpr:
    | revTupleExpr {Expr.ofTupleExpr s0}
    | revTupleExpr "," lambdaExpr {
        Expr.ofTupleLambdaExpr s0 s2
        }

revTupleExpr:
    | binaryExpr { [s0] }
    | revTupleExpr "," binaryExpr { s2::s0 }

binaryExpr:
    | revBinaryExpr { Expr.ofBinaryExpr s0 }

revBinaryExpr:
    | unaryExpr { [(None,""),s0] }
    | revBinaryExpr infix unaryExpr { (s1,s2)::s0 }

unaryExpr:
    | prifix appExpr {
        let indent, op = s0
        indent, UnaryExpr(op, snd s1)
    }
    | appExpr {s0}

appExpr:
    | revAppExpr {
        Expr.ofAppExpr s0
    }

revAppExpr:
    | qualificationExpr { [s0] }
    | revAppExpr qualificationExpr { s1::s0 }
    
qualificationExpr:
    | revQualificationExpr { Expr.ofQualification(s0) }
    
revQualificationExpr :
    | atomicExpr { [s0] }
    | revQualificationExpr qualificationSuffix { s1::s0 }

atomicExpr:
    | LITERAL {
        let i,v = s0
        i,LiteralExpr v
        }
    | IDENT { fst s0, IdentExpr(snd s0) }
    | IDENT  "<" typeArguments ">"  { 
        let targs = s2 |> List.map snd |> List.rev
        fst s0, TypeApplicationExpr(snd s0,targs) 
        }
    | "(" ")" { s0, LiteralExpr Literal.UNIT }
    | "(" infix ")" { s0, OperatorSectionExpr(snd s1) }
    | parenExpr { s0 }
    | listExpr { s0 }
    | arrayExpr { s0 }
    
qualificationSuffix:
    | "." IDENT { s0, IdentExpr(snd s1) }
    | "." IDENT  "<" typeArguments ">" { 
        let targs = s3 |> List.map snd |> List.rev
        s0, TypeApplicationExpr(snd s1,targs) }
    | "." "[" tupleExpr "]" { s2 }
      
parenExpr:
    | "(" sequentialExpr ")" { s0, ParenExpr(snd s1) }

listExpr:
    | "[" "]" { s0, ListExpr [] }
    | "[" sequentialExpr "]" { s0, ListExpr(snd s1) }

arrayExpr:
    | "[|" "|]" { s0, ArrayExpr [] }
    | "[|" sequentialExpr "|]" { s0, ArrayExpr(snd s1) }

prifix:
    | "!" {s0, "!" }
    | "+" {s0, "+" }
    | "-" {s0, "-" }

infix:
    | "%" {s0, "%"}
    | "&" { s0, "&"}
    | "&&"    { s0, "&&"   }
    | ".."    { s0, ".."   }
    | "/"     { s0, "/"    }
    | "::"    { s0, "::"   }
    | ":?"    { s0, ":?"   }
    | ":?>"   { s0, ":?>"  }
    | "<<"    { s0, "<<"   }
    | "<>"    { s0, "<>"   }
    | "<|"    { s0, "<|"   }
    | "<||"   { s0, "<||"  }
    | "<|||"  { s0, "<|||" }
    | ">>"    { s0, ">>"   }
    | "@"     { s0, "@"    }
    | "|>"    { s0, "|>"   }
    | "||"    { s0, "||"   }
    | "||>"   { s0, "||>"  }
    | "|||"   { s0, "|||"  }
    | "|||>"  { s0, "|||>" }
    | "="     { s0, "="    }
    | "+" {s0, "+" }
    | "-" {s0, "-" }

bindingPattern:
  | tuplePattern { Pattern.ofTuplePattern s0 }
    
atomicPattern:
  | parameterPattern { s0 }
  | IDENT ":" typeArgument {
    fst s0, TypeAnnotationPattern(snd s0, snd s2)
    }

parameterPattern:
  | IDENT { fst s0, IdentPattern(snd s0) }
  | "(" bindingPattern ")" { s0, snd s1 }

tuplePattern:
    | atomicPattern { [s0] }
    | tuplePattern "," atomicPattern { s2::s0 }

typeArgument:
    | funType { TypeArgument.ofFun s0 }

funType :
    | tupleType {
        let s0 = TypeArgument.ofTuple s0
        [s0]
        }
    | funType "->" tupleType {
        let s2 = TypeArgument.ofTuple s2
        s2::s0
        }
    
tupleType :
    | appType { [TypeArgument.ofApp s0] }
    | tupleType "*" appType { TypeArgument.ofApp s2::s0 }
    
appType :
    | atomType {s0,[]}
    | appType suffixType { 
        let hd,tl = s0
        hd,s1::tl }
        
atomType :
    | TYPAR {fst s0, Typar(snd s0) }
    | longid {fst s0, NamedType(snd s0)}
    | longid "<" typeArguments ">" {
            let s2 = s2 |> List.map snd |> List.rev
            fst s0, GenericType(snd s0, s2 )
        }
    | "(" typeArgument ")" {fst s1, ParenType(snd s1)}
        
suffixType:
    | longid {fst s0, IdentSuffix(snd s0)}
    | "[" "]" {s0, ArrayTypeSuffix 0}

typeArguments:
    | typeArgument { [s0] }
    | typeArguments "," typeArgument { s2::s0 }
    
// expr
%type<string list*Expr list> file
%type<(option<int>*string) list> revLongid
%type<option<int>*string list> longid
%type<option<int>*Expr list> sequentialExpr rhsBlock
%type<(option<int>*Expr) list> revSequentialExpr revTupleExpr revAppExpr revQualificationExpr
%type<option<int>*Expr> declExpr letBinding valueExpr lambdaExpr tupleExpr binaryExpr unaryExpr appExpr qualificationExpr atomicExpr qualificationSuffix parenExpr arrayExpr listExpr
%type<option<int>*string> prifix infix
%type<((option<int>*string)*(option<int>*Expr)) list> revBinaryExpr
%type<option<int>*string> IDENT
%type<option<int>*Literal> LITERAL
%type<option<int>> DO DUMMY EOF FUN LET LLPAREN MATCH MODULE OPEN RHSEND RRPAREN WHITESPACE WITH 
    "!" "#" "%" "&" "&&" "(" "(|" ")" "*" "**" "+" "," "-" "->" "." ".." "/" 
    ":" "::" ":?" ":?>" ";" "<" "<-" "<<" "<>" "<|" "<||" "<|||" 
    "=" ">" ">>" "@" "[" "[|" "]" "{" "{|" "|" "|)" "|>" "|]" "||" "||>" "|||" "|||>" "|}" "}"
    
// TypeArgument
%type<option<int>*TypeArgument> typeArgument
%type<(option<int> * TypeArgument)*((option<int> * SuffixType) list)> appType
%type<(option<int>*TypeArgument) list> tupleType funType typeArguments
%type<option<int>*SuffixType> suffixType
%type<option<int>*TypeArgument> atomType
%type<option<int>*string> TYPAR

// pattern
%type<option<int>*Pattern> bindingPattern atomicPattern parameterPattern
%type<(option<int>*Pattern)list> tuplePattern
