{
module FSharp.Substance.FSharpYacc
open FSharp.LexYacc
}

file:
    | MODULE longid EOF {
        snd s1, []
        }
    | MODULE longid revOpenOrLets opt_semicolon EOF {
        let ls = s2 |> List.rev |> List.map snd
        snd s1, ls
        }
    
revOpenOrLets:
    | revOpenOrLets ";" openOrLet  { s2::s0 }
    | openOrLet { [s0] }

openOrLet:
    | OPEN longid {s0, OpenExpr(snd s1)}
    | letBinding { s0 }

longid:
    | revLongid  {
        let i,ls = s0 |> List.rev |> List.unzip
        i.[0], ls
        }

revLongid :
    | IDENT { [s0] }
    | revLongid "." IDENT { s2 :: s0 }

revSequentialExpr:
    | revSequentialExpr ";" declExpr  { s2::s0 }
    | declExpr { [s0] }

declExpr:
    | letBinding { s0 }
    | matchExpr { s0 }
    | valueExpr { s0 }

letBinding:
    | LET bindingPattern "=" valueExpr RHSEND {
        s0, LetBindingExpr(snd s1, [snd s3])
        }
    | LET bindingPattern "=" LLPAREN revSequentialExpr opt_semicolon RRPAREN {
        s0, LetBindingExpr(snd s1, snd(Expr.ofSequentialExpr s4))
        }

matchExpr:
  | MATCH tupleExpr WITH opt_bar revRuleClauses { 
    let ruleClauses = s4 |> List.map snd |> List.rev
    s0, MatchExpr(snd s1, ruleClauses)
  }

revRuleClauses:
  | ruleClause { [s0] }
  | revRuleClauses "|" ruleClause { s2::s0 }
  
ruleClause:
  | patternAndGuard "->" valueExpr RHSEND { 
    let i,p,g = s0
    i, RuleClause(p, g, [snd s2])
    }
  | patternAndGuard "->" LLPAREN revSequentialExpr opt_semicolon RRPAREN { 
    let i,p,g = s0
    let r = s3 |> List.map snd |> List.rev
    i, RuleClause(p, g, r)
    }

patternAndGuard:
  | matchPattern { fst s0,snd s0, None }
  | matchPattern WHEN binaryExpr { fst s0,snd s0, Some(snd s2) }

valueExpr :
    | lambdaExpr { s0 }
    | tupleExpr { s0 }

lambdaExpr:
    | FUN parameterPattern "->" valueExpr RHSEND {
            s0, LambdaExpr(snd s1, [snd s3])
        }
    | FUN parameterPattern "->" LLPAREN revSequentialExpr opt_semicolon RRPAREN {
            s0, LambdaExpr(snd s1, snd(Expr.ofSequentialExpr s4))
        }

tupleExpr:
    | revTupleExpr {Expr.ofTupleExpr s0}

revTupleExpr:
    | binaryExpr { [s0] }
    | revTupleExpr "," binaryExpr { s2::s0 }

binaryExpr:
    | revBinaryExpr { Expr.ofBinaryExpr s0 }

revBinaryExpr:
    | unaryExpr { [(None,""),s0] }
    | revBinaryExpr infix unaryExpr { (s1,s2)::s0 }

unaryExpr:
    | prefix appExpr {
        let indent, op = s0
        indent, UnaryExpr(op, snd s1)
    }
    | appExpr {s0}

appExpr:
    | revAppExpr {
        Expr.ofAppExpr s0
    }

revAppExpr:
    | qualificationExpr { [s0] }
    | revAppExpr qualificationExpr { s1::s0 }
    
qualificationExpr:
    | revQualificationExpr { Expr.ofQualification(s0) }
    
revQualificationExpr:
    | atomicExpr { [s0] }
    | revQualificationExpr qualificationSuffix { s1::s0 }

atomicExpr:
    | LITERAL {
        let i,v = s0
        i,LiteralExpr v
        }
    | identExpr { s0 }
    | "(" ")" { s0, LiteralExpr Literal.UNIT }
    | "(" infix ")" { s0, OperatorSectionExpr(snd s1) }
    | parenExpr { s0 }
    | listExpr { s0 }
    | arrayExpr { s0 }
    | recdLiteralExpr { s0 }
    
identExpr:
    | IDENT { fst s0, IdentExpr(snd s0) }
    | IDENT "<" typeArguments ">" { 
        let targs = s2 |> List.map snd |> List.rev
        fst s0, TypeApplicationExpr(snd s0,targs)
        }
    
qualificationSuffix:
    | "." identExpr { s1 }
    | "." "[" tupleExpr "]" { s2 }
      
parenExpr:
    | "(" revSequentialExpr opt_semicolon ")" { s0, ParenExpr(snd (Expr.ofSequentialExpr s1)) }

listExpr:
    | "[" "]" { s0, ListExpr [] }
    | "[" revSequentialExpr opt_semicolon "]" { s0, ListExpr(snd (Expr.ofSequentialExpr s1)) }

arrayExpr:
    | "[|" "|]" { s0, ArrayExpr [] }
    | "[|" revSequentialExpr opt_semicolon "|]" { s0, ArrayExpr(snd (Expr.ofSequentialExpr s1)) }
    
recdLiteralExpr:
  | "{" fieldBindings opt_semicolon "}"  { 
        let ls = s1 |> List.map snd |> List.rev
        fst s0, ls
  }

fieldBindings:
  | fieldBinding { [s0] }
  | fieldBindings ";" fieldBinding { s2::s0 }
  
fieldBinding:
  | IDENT "=" valueExpr RHSEND {
  fst s0, (snd s0, [snd s2])
  }
  | IDENT "=" LLPAREN revSequentialExpr opt_semicolon RRPAREN {  
    fst s0, (snd s0, snd(Expr.ofSequentialExpr s3))  
  }

prefix:
    | ALWAYS_PREFIX {s0}
    | "+" {s0, "+" }
    | "-" {s0, "-" }

infix:
    | ALWAYS_INFIX {s0}
    | "*" {s0, "*"}    
    | "=" {s0, "="}
    | "+" {s0, "+"}
    | "-" {s0, "-"}
    
opt_semicolon:
    | ";" {s0}
    | {None}
    
opt_bar:
    | "|" {s0}    
    | {None}

bindingPattern:
  | tuplePattern { Pattern.ofTuplePattern s0 }
    
atomicPattern:
  | parameterPattern { s0 }
  | IDENT ":" typeArgument {
    fst s0, TypeAnnotationPattern(snd s0, snd s2)
    }
    
//用于fun parameterPattern ->
parameterPattern:
  | IDENT { fst s0, IdentPattern(snd s0) }
  | "(" bindingPattern ")" { s0, snd s1 }

tuplePattern:
    | atomicPattern { [s0] }
    | tuplePattern "," atomicPattern { s2::s0 }

matchPattern:
  | LITERAL { fst s0, LiteralPattern(snd s0) }
  | IDENT { fst s0, IdentPattern(snd s0) }

typeArgument:
    | funType { TypeArgument.ofFun s0 }

funType :
    | tupleType {
        let s0 = TypeArgument.ofTuple s0
        [s0]
        }
    | funType "->" tupleType {
        let s2 = TypeArgument.ofTuple s2
        s2::s0
        }
    
tupleType :
    | appType { [TypeArgument.ofApp s0] }
    | tupleType "*" appType { TypeArgument.ofApp s2::s0 }
    
appType :
    | atomType {s0,[]}
    | appType suffixType { fst s0, s1::snd s0 }
        
atomType :
    | TYPAR {fst s0, Typar(snd s0) }
    | longid {fst s0, NamedType(snd s0)}
    | longid "<" typeArguments ">" {
            let s2 = s2 |> List.map snd |> List.rev
            fst s0, GenericType(snd s0, s2 )
        }
    | "(" typeArgument ")" {fst s1, ParenType(snd s1)}
        
suffixType:
    | longid {fst s0, IdentSuffix(snd s0)}
    | "[" "]" {s0, ArrayTypeSuffix 0}

typeArguments:
    | typeArgument { [s0] }
    | typeArguments "," typeArgument { s2::s0 }

%type<string list*Expr list> file
%type<(option<int>*string) list> revLongid
%type<option<int>*string list> longid
%type<(option<int>*Expr) list> revSequentialExpr revTupleExpr revAppExpr revQualificationExpr revOpenOrLets
%type<option<int>*Expr> openOrLet declExpr letBinding matchExpr valueExpr lambdaExpr tupleExpr binaryExpr unaryExpr 
    appExpr qualificationExpr atomicExpr identExpr qualificationSuffix parenExpr arrayExpr listExpr
%type<option<int>*string> prefix infix
%type<(option<int>*RuleClause) list> revRuleClauses
%type<option<int>*RuleClause> ruleClause
%type<((option<int>*string)*(option<int>*Expr)) list> revBinaryExpr
%type<option<int>*string> IDENT TYPAR ALWAYS_INFIX ALWAYS_PREFIX
%type<option<int>*Literal> LITERAL
%type<option<int>> DO EOF FUN LET LLPAREN MATCH MODULE OPEN RHSEND RRPAREN WITH WHEN opt_semicolon opt_bar 
    "(" "(|" ")" "+" "*" "," "-" "->" "." ":" ";" "<" "<-" "=" ">" "[" "[|" "]" "{" "|" "|)" "|]" "}"
%type<option<int>*TypeArgument> typeArgument
%type<(option<int>*TypeArgument)*((option<int> * SuffixType) list)> appType
%type<(option<int>*TypeArgument) list> tupleType funType typeArguments
%type<option<int>*SuffixType> suffixType
%type<option<int>*TypeArgument> atomType
%type<option<int>*Pattern> bindingPattern atomicPattern parameterPattern matchPattern
%type<(option<int>*Pattern)list> tuplePattern
%type<option<int>*Pattern*Expr option> patternAndGuard
