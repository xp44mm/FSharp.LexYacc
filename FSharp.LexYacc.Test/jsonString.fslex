{
module FSharp.Jsons.JsonStringLexer
open System
open FSharp.LexYacc
open FSharp.Idioms
}

let hex_digit = [ '0'-'9' 'a'-'f' 'A'-'F' ]

rule =

'\\' 'u' hex_digit hex_digit hex_digit hex_digit { JsonStringToken.getChar buff }
'\\' '\\' { '\\' }
'\\' '"' { '"' }
'\\' '/' { '/' }
'\\' 'b' { '\b' }
'\\' 'f' { '\f' }
'\\' 'n' { '\n' }
'\\' 'r' { '\r' }
'\\' 't' { '\t' }
_ { buff.[0] }
