<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PrimitiveType.fs" />
    <Compile Include="ParseInteger.fs" />
    <Compile Include="PrimitiveParser.fs" />
    <Compile Include="Pen.fs" />
    <Compile Include="Lookup.fs" />
    <Compile Include="Literal.fs" />
    <Compile Include="FSharpToken.fs" />
    <Compile Include="Light.fs" />
    <Compile Include="Expr.fs" />
    <Compile Include="Structure.fs" />
    <Compile Include="FSharpLexer.fs" />
    <Compile Include="FSharpLexerTailer.fs" />
    <Compile Include="StyleBlock.fs" />
    <Compile Include="FSharpYacc.fs" />
    <Compile Include="RightSententialForm.fs" />
    <Compile Include="StackOps.fs" />
    <Compile Include="YaccStateSegment.fs" />
    <Compile Include="FSharpCompiler.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharp.LexYacc\FSharp.LexYacc.fsproj" />
  </ItemGroup>

</Project>
